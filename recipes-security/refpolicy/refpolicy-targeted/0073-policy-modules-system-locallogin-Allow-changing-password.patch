From 738c2e556223dce50cc835398df5c9f79b698bc4 Mon Sep 17 00:00:00 2001
From: ejaaskel <esa.jaaskela@suomi24.fi>
Date: Mon, 10 Nov 2025 12:11:30 +0000
Subject: [PATCH] policy/modules/system/locallogin: Allow changing password

Loosen up the SELinux rules so that the user password can be changed
during the log-in process. This requires that the local_login_t has
additional permissions on etc files and directories, and shadow files.
In addtion, the process needs to be able to perform setfscreate.

Upstream-Status: Inappropriate [Sulka specific]
---
 policy/modules/system/locallogin.te | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/policy/modules/system/locallogin.te b/policy/modules/system/locallogin.te
index 5840ad5a9..d5cb266a2 100644
--- a/policy/modules/system/locallogin.te
+++ b/policy/modules/system/locallogin.te
@@ -47,6 +47,9 @@ allow local_login_t self:sem create_sem_perms;
 allow local_login_t self:msgq create_msgq_perms;
 allow local_login_t self:msg { receive send };
 allow local_login_t self:key { link search write };
+allow local_login_t self:process setfscreate;
+files_manage_etc_files(local_login_t)
+auth_manage_shadow(local_login_t)
 
 allow local_login_t local_login_lock_t:file manage_file_perms;
 files_lock_filetrans(local_login_t, local_login_lock_t, file)
